# 复制为 .env 后填写。智能体的 API Key 写成 env:变量名 即可引用这里的值
# DEEPSEEK_API_KEY=sk-xxx          # DeepSeek 智能体可以写 env:DEEPSEEK_API_KEY
# ANTHROPIC_API_KEY=sk-ant-xxx     # Claude 智能体的 Key 留空时自动使用

# PORT=8787
# HOST=0.0.0.0                     # 允许手机等局域网设备访问（要先用访问码登录）。默认 127.0.0.1，只允许本机
# HISTORY_CHARS=24000              # 每次发给模型的聊天记录长度上限（字）
# CALL_TIMEOUT_MS=600000           # 单次模型调用超时（毫秒）
# RELAY_TIMEOUT_MS=3600000         # 手动转达最多等多久（毫秒）
# LOCAL_SERVER_START_MS=180000     # 「启动命令」启动本机模型服务后最多等多久（毫秒）
# LOCAL_SERVER_IDLE_MIN=15         # 自动启动的本机模型服务闲置多少分钟后关掉（省内存）
